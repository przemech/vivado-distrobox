# Copy to config.env and edit. config.env stays out of git.

# AMD tools installation path.
# Must have the same path on the host and in the container;
# paths outside $HOME are mounted into the container automatically.
XILINX_DIR="$HOME/Xilinx"

# Versions to create distrobox containers for (each needs versions/<version>.ini)
VERSIONS="2025.2"

# Default version for `vivado` / `vitis` commands.
DEFAULT_VERSION="2025.2"

# Optional per-version directory (dots in the version become underscores)
# XILINX_DIR_2024_2="/data/Xilinx"
